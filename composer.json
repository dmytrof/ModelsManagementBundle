{
    "name": "dmytrof/models-management-bundle",
    "type": "symfony-bundle",
    "description": "Symfony ModelsManagementBundle to manage models and entities",
    "keywords": ["Models management", "Entities management", "Manager"],
    "license": "MIT",
    "authors": [
        {
            "name": "Dmytro Feshchenko",
            "email": "dmytro.feshchenko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/framework-bundle": "^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/validator": "^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/form": "^5.0 || ^6.0 || ^7.0 || ^8.0",
        "doctrine/orm": "^2.6",
        "doctrine/inflector": "^2.0",
        "gedmo/doctrine-extensions": "^3.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.3 || ^9.1"
    },
    "autoload": {
        "psr-4": {
            "Dmytrof\\ModelsManagementBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dmytrof\\ModelsManagementBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
